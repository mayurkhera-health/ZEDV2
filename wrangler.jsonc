{
  // Assets-only Worker: no script, no server-side code. Cloudflare serves the
  // contents of dist/ straight from the edge, which is all a static site needs.
  //
  // Created because the Cloudflare dashboard now routes "connect a repo" into
  // the Workers flow rather than Pages, and a Workers build runs
  // `npx wrangler deploy`, which needs this file to know what to deploy.
  // MUST match the Worker that already exists, or a deploy creates a second
  // one and leaves the first serving whatever it last had. The first build
  // ran with no config, so wrangler generated {"directory": "."} and shipped
  // the repository root -- .git included. Redeploying over the same name is
  // what replaces that asset manifest.
  "name": "zedv2",
  "compatibility_date": "2026-09-15",

  "assets": {
    // Built by scripts/build.sh. Deliberately NOT the repository root: that
    // would publish docs/, scripts/ and the UX audit alongside the site.
    "directory": "./dist",

    // Serve 404.html for unknown paths, with a 404 status, rather than the
    // default bare Cloudflare error page.
    "not_found_handling": "404-page"
  }
}
