# Cloudflare Pages headers for automatesmall.com. LIVE as of 16 Sep 2026.
#
# The staging X-Robots-Tag was removed on launch. Do not put it back here to
# hide a work-in-progress -- use a preview branch, which Cloudflare serves on
# its own hostname, and leave production indexable.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: no-cache

# Assets are not fingerprinted -- styles.css and site.js never change name --
# so they revalidate rather than being held. Fingerprint them at launch and a
# long max-age can go back here.
/assets/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: no-cache
